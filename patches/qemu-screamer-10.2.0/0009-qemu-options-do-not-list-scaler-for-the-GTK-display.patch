From a50b26aad09f191708b62e105307fba2b36c4f94 Mon Sep 17 00:00:00 2001
From: zirize <zirize@gmail.com>
Date: Tue, 24 Nov 2026 22:55:11 +0900
Subject: [PATCH 9/9] qemu-options: do not list scaler= for the GTK display

The scaler option was added to the GTK usage line together with the SDL
one, but the GTK display never reads it, so the help advertised an option
that does nothing there.

Signed-off-by: zirize <zirize@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Q78o7VG6jAieKBpedzps5M
---
 qemu-options.hx | 1 -
 1 file changed, 1 deletion(-)

diff --git a/qemu-options.hx b/qemu-options.hx
index 3570caf077..8ef0c6cf76 100644
--- a/qemu-options.hx
+++ b/qemu-options.hx
@@ -2135,7 +2135,6 @@ DEF("display", HAS_ARG, QEMU_OPTION_display,
     "-display gtk[,full-screen=on|off][,gl=on|off][,grab-on-hover=on|off]\n"
     "            [,show-tabs=on|off][,show-cursor=on|off][,window-close=on|off]\n"
     "            [,show-menubar=on|off][,zoom-to-fit=on|off]\n"
-    "            [,scaler=linear|nearest|integer|integerplus]\n"
 #endif
 #if defined(CONFIG_VNC)
     "-display vnc=<display>[,<optargs>]\n"
-- 
2.53.0

